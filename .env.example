# Şablon: .env olarak kopyalayıp doldurun (.env git'e girmez).
# Proje Docker'da çalışır; docker compose bu dosyayı otomatik okur.
# NEXT_PUBLIC_* değerleri build sırasında koda gömülür; değişince yeniden derlenir.

# Local: NEXT_PUBLIC_BASE_URL=http://localhost:8000, API_INTERNAL_URL=http://host.docker.internal:8000
# Prod:  NEXT_PUBLIC_BASE_URL=https://api.cevirkazan360.com, API_INTERNAL_URL boş
#        (boşsa sunucu tarafı da NEXT_PUBLIC_BASE_URL'i kullanır)
NEXT_PUBLIC_BASE_URL=http://localhost:8000
API_INTERNAL_URL=http://host.docker.internal:8000
PORT=3000
# Sitenin herkese açık adresi: canonical, sitemap, Open Graph ve JSON-LD için (sonunda / olmadan).
# Local: http://localhost:3000, Prod: https://cevirkazan360.com. Boşsa localhost kullanılır.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Salon başvurularının düşeceği WhatsApp numarası (ülke koduyla, boşluksuz: 905xxxxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=
